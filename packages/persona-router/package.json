{
  "name": "dsh-superagent-persona-router",
  "version": "0.1.0",
  "private": false,
  "description": "A DSH policy bundle for dsh-superagent: the optional Persona catalog, explainable task routing rules and operator overrides behind a reproducible router registered on `orchestrator.persona`.",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "manifestVersion": 1
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.5-alpha.1"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  }
}
